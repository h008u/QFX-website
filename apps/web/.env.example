# ========== Supabase (عام — آمن في المتصفح مع تفعيل RLS) ==========
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ========== روابط التسويق ==========
# رابط الإحالة الخاص بك لدى شركة الوساطة (IB / Affiliate link)
NEXT_PUBLIC_IB_REFERRAL_URL=https://broker.example.com/register?ib=YOUR_ID
# اسم شركة الوساطة الشريكة كما يظهر في الموقع
NEXT_PUBLIC_BROKER_NAME=شركة الوساطة الشريكة
# رابط قناة تيليجرام العامة
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
# رابط الموقع النهائي
NEXT_PUBLIC_SITE_URL=https://qfx.vercel.app

# ========== لوحة الإدارة /admin (خادم فقط — لا تضع NEXT_PUBLIC) ==========
# الدخول للوحة بحساب Supabase دوره admin/editor/viewer (انظر README)
# رابط خدمة البوت على Render/Koyeb (للنشر والفحوصات والتجارب من اللوحة)
BOT_API_URL=https://qfx-bot.onrender.com
# نفس القيمة (لعرض رابط TradingView Webhook في الإعدادات)
BOT_PUBLIC_URL=https://qfx-bot.onrender.com
# نفس قيمة BOT_API_KEY في خدمة البوت
BOT_API_KEY=change-me-long-random-key
# نفس قيمة TRADINGVIEW_WEBHOOK_SECRET في البوت (يظهر للمدير فقط)
TRADINGVIEW_WEBHOOK_SECRET=
# نفس قيمة MT5_SECRET في البوت (لعرض رابط إضافة MT5 للمدير)
MT5_SECRET=
# مفتاح service_role — سرّي. مطلوب لتغيير أدوار الفريق وإضافة الأعضاء بالبريد
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ========== بيانات الأسعار للشارت (اختياري — خطة مجانية 800 طلب/يوم) ==========
# https://twelvedata.com — بدون المفتاح يعرض الشارت بيانات توضيحية
TWELVEDATA_API_KEY=

# ========== إشعارات المتصفح للفريق (نفس مفاتيح البوت) ==========
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ========== الأمان ==========
# true = كل أعضاء الفريق لازم يفعّلون التحقق بخطوتين (تطبيق مصادقة) قبل دخول اللوحة
ADMIN_REQUIRE_MFA=false

# ثيم افتراضي إن لم يُحفظ ثيم من لوحة التحكم: institutional | classic | terminal | neon | luxe
NEXT_PUBLIC_SITE_THEME=institutional

# حسابات رسمية لربط الكيان في محركات البحث (sameAs) — مفصولة بفواصل
NEXT_PUBLIC_SAME_AS=
