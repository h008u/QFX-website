{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "../../node_modules/dejavu-fonts-ttf/{package.json,ttf/DejaVuSans.ttf,ttf/DejaVuSans-Bold.ttf,ttf/DejaVuSansMono.ttf}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
