{
  "name": "@qfx/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "خدمة بوت تيليجرام (Webhooks) — نشر التوصيات والأخبار والمفكرة الاقتصادية",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "set-webhook": "tsx --env-file-if-exists=.env scripts/set-webhook.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@supabase/supabase-js": "^2.80.0",
    "fast-xml-parser": "^5.12.0",
    "grammy": "^1.38.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@qfx/shared": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
