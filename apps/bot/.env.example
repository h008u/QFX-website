# ========== Telegram ==========
# من @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# سلسلة عشوائية (A-Z a-z 0-9 _ -) يتحقق بها البوت من أن الطلب قادم من تيليجرام
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
# معرّف القناة التي تُنشر فيها التوصيات والأخبار، مثل @qfx_signals أو -1001234567890
# (يجب إضافة البوت كمشرف في القناة)
TELEGRAM_CHANNEL_ID=@your_channel
# معرّفات حسابات تيليجرام المسموح لها بأوامر /signal و /news (أرسل /id للبوت لمعرفة معرّفك)
TELEGRAM_ADMIN_IDS=111111111,222222222

# ========== Supabase ==========
SUPABASE_URL=https://xxxxxxxx.supabase.co
# مفتاح service_role (سرّي — يُستخدم في الخادم فقط ويتجاوز RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ========== أمان واجهات API ==========
# مفتاح مشترك بين لوحة التحكم في الموقع وهذه الخدمة (Authorization: Bearer ...)
BOT_API_KEY=change-me-long-random-key
# سر يُضاف لرابط تنبيهات TradingView: /webhooks/tradingview?secret=...
TRADINGVIEW_WEBHOOK_SECRET=change-me-tv-secret

# ========== عام ==========
# الرابط العام لهذه الخدمة على Render/Koyeb (يُستخدم في set-webhook)
PUBLIC_URL=https://qfx-bot.onrender.com
# رابط الموقع (يظهر في رسائل القناة)
SITE_URL=https://qfx.vercel.app
PORT=8080

# ========== المفكرة الاقتصادية ==========
# العملات المراد متابعتها
CALENDAR_CURRENCIES=USD,EUR,GBP,JPY,CHF,CAD,AUD,NZD
# أدنى مستوى تأثير: high أو medium
CALENDAR_MIN_IMPACT=high
# المنطقة الزمنية لعرض أوقات الأخبار
CALENDAR_TIMEZONE=Asia/Riyadh
